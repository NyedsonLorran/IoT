#include <stdio.h>
#include <string.h>
#include <time.h>
#include "esp_system.h"
#include "esp_wifi.h"
#include "esp_event.h"
#include "nvs_flash.h"
#include "esp_netif.h"
#include "esp_log.h"
#include "esp_sntp.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

// Credenciais Wi-Fi
#define SSID "Wokwi-GUEST"
#define PASSWORD ""

static const char *LOG_TAG = "TIME_SYNC";

//  WIFI GOI

static void handle_wifi_events(void *arg, esp_event_base_t base,
                               int32_t id, void *data) {

    switch (id) {
        case WIFI_EVENT_STA_START:
            esp_wifi_connect();
            break;

        case WIFI_EVENT_STA_DISCONNECTED:
            ESP_LOGW(LOG_TAG, "Conexão perdida. Tentando reconectar...");
            esp_wifi_connect();
            break;

        case IP_EVENT_STA_GOT_IP:
            ESP_LOGI(LOG_TAG, "Conectado com sucesso ao Wi-Fi!");
            break;

        default:
            break;
    }
}

void start_wifi(void) {
    esp_netif_init();
    esp_event_loop_create_default();
    esp_netif_create_default_wifi_sta();

    wifi_init_config_t config = WIFI_INIT_CONFIG_DEFAULT();
    esp_wifi_init(&config);

    esp_event_handler_instance_t wifi_handler;
    esp_event_handler_instance_t ip_handler;

    esp_event_handler_instance_register(WIFI_EVENT,
                                        ESP_EVENT_ANY_ID,
                                        &handle_wifi_events,
                                        NULL,
                                        &wifi_handler);

    esp_event_handler_instance_register(IP_EVENT,
                                        IP_EVENT_STA_GOT_IP,
                                        &handle_wifi_events,
                                        NULL,
                                        &ip_handler);

    wifi_config_t wifi_cfg = {
        .sta = {
            .ssid = SSID,
            .password = PASSWORD,
        }
    };

    esp_wifi_set_mode(WIFI_MODE_STA);
    esp_wifi_set_config(WIFI_IF_STA, &wifi_cfg);
    esp_wifi_start();
}

// -------------------- SNTP --------------------

void config_sntp(void) {
    ESP_LOGI(LOG_TAG, "Configurando SNTP...");

    esp_sntp_setoperatingmode(SNTP_OPMODE_POLL);

    esp_sntp_setservername(0, "a.ntp.br");
    esp_sntp_setservername(1, "b.ntp.br");
    esp_sntp_setservername(2, "c.ntp.br");

    esp_sntp_init();
}

void wait_for_time_sync(void) {
    config_sntp();

    time_t current_time = 0;
    struct tm time_data = { 0 };

    int attempts = 0;
    const int max_attempts = 10;

    while ((time_data.tm_year < (2020 - 1900)) && attempts < max_attempts) {
        ESP_LOGI(LOG_TAG, "Sincronizando horário... tentativa %d", attempts + 1);

        vTaskDelay(pdMS_TO_TICKS(2000));

        time(&current_time);
        localtime_r(&current_time, &time_data);

        attempts++;
    }
}

// -------------------- LOOP PRINCIPAL --------------------

void print_current_time(void) {
    time_t now;
    struct tm info;

    time(&now);
    localtime_r(&now, &info);

    printf("Agora: %02d/%02d/%04d %02d:%02d:%02d\n",
           info.tm_mday,
           info.tm_mon + 1,
           info.tm_year + 1900,
           info.tm_hour,
           info.tm_min,
           info.tm_sec);
}

void app_main(void) {

    // Inicializa memória NVS
    nvs_flash_init();

    // Conecta ao Wi-Fi
    start_wifi();

    // Aguarda conexão estabilizar
    vTaskDelay(pdMS_TO_TICKS(5000));

    // Sincroniza horário
    wait_for_time_sync();

    // Define timezone (Brasil)
    setenv("TZ", "BRT3", 1);
    tzset();

    // Loop infinito exibindo horário
    while (1) {
        print_current_time();
        vTaskDelay(pdMS_TO_TICKS(5000));
    }
}